<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models ="clr-namespace:CadastraApp.Models"
             x:DataType="models:Evento"
             x:Class="CadastraApp.ResumoPage"
             Title="Resumo">
    <VerticalStackLayout>
        <Label Text="{Binding Nome, StringFormat='Nome do Evento: {0}'}"></Label>
        <Label Text="{Binding DataInicio, StringFormat='Inicia em: {0:dd/MM/yyyy}'}"></Label>
        <Label Text="{Binding DataTermino, StringFormat='Termina em: {0:dd/MM/yyyy}'}"></Label>
        <Label Text="{Binding DuracaoDias, StringFormat='Duracao: {0} Dias'}"></Label>
        <Label Text="{Binding CustoTotal, StringFormat='Custo Total: {0:C}'}"></Label>
        <Label Text="{Binding Local, StringFormat='Local do Evento: {0}'}"></Label>
        <Label Text="{Binding QtdParticipantes, StringFormat='Quantidade de participantes: {0}'}"></Label>
    </VerticalStackLayout>
</ContentPage>